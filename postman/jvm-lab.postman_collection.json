      ]
    },
    {
      "name": "Keycloak (WP-08)",
      "description": "Local OIDC provider. The lab realm and client are created in WP-08; the admin token request works out of the box.",
      "item": [
        {
          "name": "Admin token (master realm)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/master/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "admin-cli",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{keycloakAdminUser}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{keycloakAdminPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Stores the token in `keycloakAdminToken` for Keycloak admin API calls."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has access token', () => pm.expect(pm.response.json().access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('keycloakAdminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "customerId",
      "value": "customer-1"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "keycloakAdminToken",
      "value": ""
    }
  ]
}
